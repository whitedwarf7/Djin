# Copy to .env and fill in. Never commit .env.

# ---------- LLM ----------
# openrouter | openai
DJIN_LLM_PROVIDER=openrouter
DJIN_OPENROUTER_API_KEY=
DJIN_OPENAI_API_KEY=
# OpenRouter example: openai/gpt-4o-mini | OpenAI example: gpt-4o-mini
DJIN_LLM_MODEL=openai/gpt-4o-mini

# ---------- Google (Gmail + Calendar) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Desktop app
DJIN_GOOGLE_CLIENT_ID=
DJIN_GOOGLE_CLIENT_SECRET=

# ---------- Web search ----------
# brave | tavily | none
DJIN_SEARCH_PROVIDER=none
DJIN_BRAVE_API_KEY=
DJIN_TAVILY_API_KEY=

# ---------- Safety ----------
# Local/reversible writes (notes, gmail drafts) run without a confirmation prompt.
# Externally visible and destructive actions always require approval.
DJIN_AUTO_APPROVE_WRITE=true

# ---------- Scheduler + push notifications ----------
# Schedules run only while the Djin server is running. Use "local" or an IANA timezone.
DJIN_SCHEDULER_ENABLED=true
DJIN_SCHEDULER_TIMEZONE=local
# Optional ntfy delivery. Use a long random topic name with the public ntfy.sh server.
DJIN_NTFY_TOPIC=
DJIN_NTFY_BASE_URL=https://ntfy.sh
DJIN_NTFY_TOKEN=

# ---------- Server ----------
DJIN_HOST=127.0.0.1
DJIN_PORT=8765

# Optional: Fernet key for the token vault. Generated into data/secret.key if empty.
DJIN_ENCRYPTION_KEY=
